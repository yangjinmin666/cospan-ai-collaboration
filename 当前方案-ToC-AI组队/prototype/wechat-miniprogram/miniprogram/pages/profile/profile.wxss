.profile-page { overflow-x: hidden; background: #f7f8fa; }

.profile-header { min-height: 92rpx; display: flex; align-items: center; justify-content: space-between; gap: 18rpx; padding: 6rpx 0 20rpx; }
.profile-title-group { min-width: 0; display: flex; align-items: center; gap: 20rpx; }
.settings-trigger { box-sizing: border-box; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 1rpx solid #d8dfe7; border-radius: 50%; background: #fff; color: #1f2c39; box-shadow: 0 10rpx 24rpx rgba(31,48,70,.09); }
.settings-trigger text { font-family: Arial, sans-serif; font-size: 37rpx; font-weight: 700; line-height: 1; }
.profile-page-title { color: #17212d; font-size: 43rpx; font-weight: 820; line-height: 1; }

.event-context { box-sizing: border-box; width: 260rpx; height: 88rpx; flex: 0 0 260rpx; display: flex; align-items: center; gap: 12rpx; padding: 0 17rpx; overflow: hidden; border: 1rpx solid #d7dde5; border-radius: 27rpx; background: #fff; }
.context-icon { position: relative; width: 34rpx; height: 38rpx; flex: 0 0 34rpx; border: 4rpx solid #4d5967; border-radius: 10rpx; }
.context-icon::after { position: absolute; left: 7rpx; bottom: 8rpx; width: 15rpx; height: 4rpx; border-radius: 99rpx; background: #4d5967; content: ""; }
.context-icon i { position: absolute; right: -7rpx; top: -6rpx; width: 14rpx; height: 14rpx; border: 4rpx solid #fff; border-radius: 50%; background: #347cf8; }
.context-copy { min-width: 0; display: grid; gap: 2rpx; }
.context-copy small { color: #8a929b; font-size: 20rpx; line-height: 1.1; }
.context-copy strong { overflow: hidden; color: #273341; font-size: 20rpx; line-height: 1.2; text-overflow: ellipsis; white-space: nowrap; }

.profile-intro { display: flex; align-items: center; gap: 30rpx; padding: 18rpx 0 24rpx; }
.profile-avatar { width: 164rpx; height: 164rpx; box-shadow: 0 13rpx 30rpx rgba(31,48,70,.08); }
.profile-intro-copy { min-width: 0; }
.profile-name { overflow: hidden; color: #17212d; font-size: 52rpx; font-weight: 820; line-height: 1.05; text-overflow: ellipsis; white-space: nowrap; }
.profile-role { overflow: hidden; margin-top: 13rpx; color: #6f7b88; font-size: 26rpx; text-overflow: ellipsis; white-space: nowrap; }
.passport-id { margin-top: 25rpx; color: #788595; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }

.visibility-panel { box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 1fr) 86rpx; align-items: center; gap: 20rpx; margin: 16rpx 0 26rpx; padding: 28rpx 30rpx; border: 1rpx solid #d8dee5; border-radius: 34rpx; background: #fff; }
.micro-label { color: #758395; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 760; letter-spacing: 3rpx; }
.visibility-title { margin-top: 13rpx; color: #17212d; font-size: 34rpx; font-weight: 800; line-height: 1.15; }
.visibility-detail { margin-top: 11rpx; color: #73808d; font-size: 22rpx; line-height: 1.55; }
.profile-switch-wrap { box-sizing: border-box; min-width: 88rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-end; justify-self: end; margin: 0; padding: 0; border: 0; background: transparent; line-height: 1; }
.profile-switch-wrap[disabled] { opacity: .48; }
.profile-switch { position: relative; box-sizing: border-box; width: 74rpx; height: 44rpx; border: 1rpx solid #cfd6de; border-radius: 99rpx; background: #d8dde3; transition: background .18s ease; }
.profile-switch i { position: absolute; top: 4rpx; left: 4rpx; width: 34rpx; height: 34rpx; border-radius: 50%; background: #fff; box-shadow: 0 3rpx 8rpx rgba(31,48,70,.18); transition: transform .18s ease; }
.profile-switch.is-on { border-color: #347cf8; background: #347cf8; }
.profile-switch.is-on i { transform: translateX(30rpx); }

.outward-card { overflow: hidden; margin-bottom: 28rpx; border: 1rpx solid #d8dee5; border-radius: 38rpx; background: #fff; box-shadow: 0 18rpx 44rpx rgba(31,48,70,.065); }
.outward-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; padding: 30rpx 31rpx 22rpx; }
.outward-title { margin-top: 10rpx; color: #17212d; font-size: 36rpx; font-weight: 820; letter-spacing: -1rpx; }
.block-count { flex: 0 0 auto; margin-top: 4rpx; padding: 10rpx 15rpx; border-radius: 99rpx; background: #edf3fd; color: #2869cf; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.outward-identity { display: grid; grid-template-columns: 86rpx minmax(0, 1fr) auto; align-items: center; gap: 18rpx; margin: 0 31rpx 24rpx; padding: 24rpx 0; border-top: 1rpx solid #e3e8ed; border-bottom: 1rpx solid #e3e8ed; }
.outward-avatar { width: 84rpx; height: 84rpx; }
.outward-person { min-width: 0; display: grid; gap: 6rpx; }
.outward-person strong { overflow: hidden; color: #17212d; font-size: 28rpx; text-overflow: ellipsis; white-space: nowrap; }
.outward-person text { overflow: hidden; color: #707c88; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.public-state { padding: 9rpx 13rpx; border-radius: 99rpx; background: #e8f5ee; color: #2d7253; font-size: 20rpx; font-weight: 760; white-space: nowrap; }

.public-blocks { display: grid; gap: 14rpx; padding: 0 24rpx 24rpx; }
.public-block { min-width: 0; display: grid; grid-template-columns: 82rpx minmax(0, 1fr); align-items: center; gap: 18rpx; padding: 19rpx; border: 1rpx solid #dce3ea; border-radius: 26rpx; background: #f7f9fb; }
.public-block-mark { width: 80rpx; height: 80rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #eaf2ff; color: #2869cf; font-family: "SFMono-Regular", Menlo, monospace; font-size: 23rpx; font-weight: 850; }
.public-block > view:last-child { min-width: 0; display: grid; gap: 5rpx; }
.public-block text { color: #778493; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.public-block strong { overflow: hidden; color: #263341; font-size: 23rpx; line-height: 1.4; text-overflow: ellipsis; white-space: nowrap; }
.public-block small { overflow: hidden; color: #75818e; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.public-block-authorization { width: fit-content; margin-top: 5rpx; padding: 6rpx 10rpx; border-radius: 99rpx; background: #eef1f4; color: #6d7782; font-size: 20rpx; font-weight: 700; letter-spacing: 0; }
.public-block-authorization.is-authorized { background: #e8f5ee; color: #2d7253; }
.public-empty { min-height: 260rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 24rpx 24rpx; padding: 24rpx; border: 2rpx dashed #ccd8e5; border-radius: 28rpx; background: #f8fafc; text-align: center; }
.empty-add { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 18rpx; border-radius: 24rpx; background: #edf3fd; color: #347cf8; font-size: 47rpx; font-weight: 300; line-height: 1; }
.public-empty strong { color: #17212d; font-size: 26rpx; }
.public-empty text { max-width: 520rpx; margin-top: 12rpx; color: #75818e; font-size: 20rpx; line-height: 1.55; }
.outward-actions { display: grid; grid-template-columns: 1.2fr 1fr; gap: 14rpx; padding: 24rpx 24rpx 0; border-top: 1rpx solid #e3e8ed; }
.outward-actions button { min-height: 82rpx; margin: 0; border-radius: 23rpx; font-size: 22rpx; font-weight: 780; line-height: 82rpx; }
.profile-add-content { background: #347cf8; color: #fff; }
.profile-add-content text { margin-right: 4rpx; font-size: 34rpx; vertical-align: -2rpx; }
.profile-edit-foundation { border: 1rpx solid #d6dee7; background: #fff; color: #536170; }
.public-boundary { padding: 19rpx 31rpx 28rpx; color: #798692; font-size: 20rpx; line-height: 1.5; text-align: center; }

.profile-loading-state, .profile-error-state { min-height: 600rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 24rpx; text-align: center; }
.profile-loading-state strong, .profile-error-state strong { margin-top: 24rpx; color: #17212d; font-size: 30rpx; }
.profile-loading-state text, .profile-error-state text { max-width: 520rpx; margin-top: 12rpx; color: #74808c; font-size: 22rpx; line-height: 1.55; }
.loading-orbit { width: 66rpx; height: 66rpx; border: 5rpx solid #dce7f8; border-top-color: #347cf8; border-radius: 50%; animation: profile-loading 1s linear infinite; }
.error-mark { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #eef1f4; color: #65717e; font-size: 40rpx; font-weight: 800; }
.profile-error-state button { min-width: 220rpx; min-height: 88rpx; margin: 30rpx 0 0; border: 1rpx solid #d1dae4; border-radius: 23rpx; background: #fff; color: #344252; font-size: 24rpx; font-weight: 760; line-height: 88rpx; }
@keyframes profile-loading { to { transform: rotate(360deg); } }

.device-preview { box-sizing: border-box; margin-bottom: 28rpx; padding: 29rpx 26rpx 26rpx; border: 1rpx solid #d8dee5; border-radius: 34rpx; background: #fff; }
.device-preview-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 22rpx; }
.device-preview-title { margin-top: 10rpx; color: #17212d; font-size: 31rpx; font-weight: 800; }
.sync-chip { display: grid; gap: 3rpx; padding: 10rpx 13rpx; border-radius: 18rpx; background: #eef6f1; color: #547062; text-align: right; }
.sync-chip strong { color: #2d7253; font-size: 20rpx; }
.sync-chip text { font-size: 20rpx; }
.demo-badge { overflow: hidden; border: 1rpx solid #cfdae6; border-radius: 28rpx; background: #f5f8fb; box-shadow: inset 0 0 0 8rpx #e8edf2; }
.demo-badge.is-paused { filter: grayscale(.65); opacity: .72; }
.demo-badge-top { display: grid; grid-template-columns: auto minmax(0, 1fr); align-items: center; gap: 5rpx 16rpx; padding: 25rpx 27rpx 18rpx; border-bottom: 1rpx solid #d9e2eb; }
.demo-badge-brand { color: #17212d; font-size: 27rpx; font-weight: 900; letter-spacing: 1rpx; }
.demo-badge-brand text { margin-left: 5rpx; color: #347cf8; font-size: 20rpx; }
.demo-badge-event { overflow: hidden; color: #667585; font-size: 20rpx; font-weight: 700; text-align: right; text-overflow: ellipsis; white-space: nowrap; }
.demo-badge-state { grid-column: 1 / -1; color: #2d7253; font-size: 20rpx; font-weight: 760; }
.demo-badge-main { display: grid; gap: 17rpx; padding: 25rpx 27rpx; }
.badge-identity { display: grid; grid-template-columns: 94rpx minmax(0, 1fr); align-items: center; gap: 18rpx; }
.badge-avatar { width: 92rpx; height: 92rpx; }
.badge-identity > view:last-child { min-width: 0; display: grid; gap: 4rpx; }
.badge-identity small, .badge-intent small { color: #7a8794; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; letter-spacing: 1rpx; }
.badge-identity strong { overflow: hidden; color: #17212d; font-size: 31rpx; text-overflow: ellipsis; white-space: nowrap; }
.badge-identity text { overflow: hidden; color: #64717e; font-size: 21rpx; text-overflow: ellipsis; white-space: nowrap; }
.badge-intent { display: grid; gap: 7rpx; padding: 19rpx 20rpx; border-radius: 21rpx; background: #eaf2ff; }
.badge-intent strong { color: #1e4d96; font-size: 24rpx; line-height: 1.4; }
.badge-intent text { color: #5f7290; font-size: 20rpx; }
.badge-connect { display: grid; grid-template-columns: 76rpx minmax(0, 1fr); align-items: center; gap: 0 17rpx; }
.badge-connect > strong { align-self: end; color: #17212d; font-size: 23rpx; }
.badge-connect > text { align-self: start; color: #74808c; font-size: 20rpx; }
.badge-qr { grid-row: 1 / 3; width: 72rpx; height: 72rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; padding: 5rpx; border: 1rpx solid #cbd5df; background: #fff; }
.badge-qr i { background: #1f2b38; }
.badge-qr i:nth-child(2), .badge-qr i:nth-child(4), .badge-qr i:nth-child(8) { background: #fff; box-shadow: inset 0 0 0 4rpx #1f2b38; }
.demo-badge-foot { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 15rpx 27rpx 22rpx; color: #657382; font-size: 20rpx; }
.badge-code { font-family: "SFMono-Regular", Menlo, monospace; font-weight: 800; }
.edit-badge-button { width: 100%; min-height: 88rpx; margin: 20rpx 0 0; border: 1rpx solid #d2dbe4; border-radius: 22rpx; background: #f7f9fb; color: #485767; font-size: 23rpx; font-weight: 760; line-height: 88rpx; }

.platform-panel { box-sizing: border-box; margin-bottom: 24rpx; padding: 29rpx 26rpx 24rpx; border: 1rpx solid #d8dee5; border-radius: 34rpx; background: #fff; }
.platform-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.platform-panel-head > view:last-child { flex: 0 0 auto; padding: 8rpx 12rpx; border-radius: 99rpx; background: #f1f3f6; color: #707c89; font-size: 20rpx; }
.platform-title { margin-top: 10rpx; color: #17212d; font-size: 31rpx; font-weight: 800; }
.platform-note { margin: 16rpx 0 20rpx; color: #75818e; font-size: 20rpx; line-height: 1.55; }
.platform-list { overflow: hidden; border: 1rpx solid #dce3eb; border-radius: 25rpx; background: #fff; }
.platform-row { display: grid; grid-template-columns: 66rpx minmax(0, 1fr) auto; align-items: center; gap: 15rpx; padding: 19rpx; border-bottom: 1rpx solid #e6ebf0; }
.platform-row:last-child { border-bottom: 0; }
.platform-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: #eaf2ff; color: #347cf8; font-size: 21rpx; font-weight: 800; }
.github-mark { background: #17212d; color: #fff; font-size: 20rpx; }
.xhs-mark { background: #f1f3f6; color: #596675; font-size: 20rpx; }
.platform-main { min-width: 0; }
.platform-main .card-title { font-size: 22rpx; }
.platform-main input { height: 52rpx; margin-top: 3rpx; color: #536170; font-size: 20rpx; line-height: 52rpx; }
.platform-row button { min-width: 88rpx; min-height: 88rpx; margin: 0; padding: 0 15rpx; border: 1rpx solid #d3dbe4; border-radius: 18rpx; background: #f7f9fb; color: #536170; font-size: 20rpx; line-height: 88rpx; }
.account-note { margin: 0 0 20rpx; padding: 21rpx 23rpx; border-radius: 23rpx; background: #f0f2f5; color: #6f7b87; font-size: 20rpx; line-height: 1.55; }

.profile-fields { overflow: hidden; margin-bottom: 24rpx; border: 1rpx solid #dce2e9; border-radius: 28rpx; background: #fff; }
.profile-fields button { box-sizing: border-box; width: 100%; min-height: 112rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16rpx; margin: 0; padding: 20rpx 23rpx; border: 0; border-bottom: 1rpx solid #e7ebf0; border-radius: 0; background: #fff; color: #17212d; line-height: 1.2; text-align: left; }
.profile-fields button:last-child { border-bottom: 0; }
.profile-fields button view { min-width: 0; display: grid; gap: 8rpx; }
.profile-fields strong { font-size: 24rpx; }
.profile-fields text { overflow: hidden; color: #778390; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.profile-fields b { color: #6c7885; font-size: 20rpx; }

.settings-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; }
.settings-backdrop { position: absolute; inset: 0; background: rgba(20,28,38,.28); }
.settings-sheet { position: relative; z-index: 2; box-sizing: border-box; width: 100%; max-height: 88vh; overflow-y: auto; padding: 15rpx 32rpx calc(34rpx + env(safe-area-inset-bottom)); border-radius: 40rpx 40rpx 0 0; background: #f5f7fa; box-shadow: 0 -20rpx 52rpx rgba(31,48,70,.14); }
.settings-handle { width: 78rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: 99rpx; background: #cdd4dc; }
.settings-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.settings-head strong { display: block; margin-top: 6rpx; color: #17212d; font-size: 36rpx; }
.settings-head button { width: 70rpx; height: 70rpx; margin: 0; padding: 0; border: 1rpx solid #d9e0e7; border-radius: 50%; background: #fff; color: #546271; font-size: 34rpx; line-height: 70rpx; }
.settings-list { overflow: hidden; border: 1rpx solid #dce2e9; border-radius: 28rpx; background: #fff; }
.settings-list > button { box-sizing: border-box; width: 100%; min-height: 116rpx; display: grid; grid-template-columns: 68rpx minmax(0, 1fr) 24rpx; align-items: center; gap: 17rpx; margin: 0; padding: 20rpx 22rpx; border: 0; border-bottom: 1rpx solid #e7ebf0; border-radius: 0; background: #fff; color: #17212d; line-height: 1.2; text-align: left; }
.settings-list > button:last-child { border-bottom: 0; }
.settings-mark { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #eef3f8; color: #526170; font-size: 22rpx; font-weight: 800; }
.settings-list button > view:nth-child(2) { min-width: 0; display: grid; gap: 7rpx; }
.settings-list strong { font-size: 24rpx; }
.settings-list text { overflow: hidden; color: #778390; font-size: 20rpx; text-overflow: ellipsis; white-space: nowrap; }
.settings-arrow { color: #9aa4ae; font-size: 34rpx; font-weight: 400; }
.settings-sfx { font-size: 20rpx; }
.settings-mini-toggle { position: relative; width: 62rpx; height: 36rpx; border-radius: 99rpx; background: #d6dce2; }
.settings-mini-toggle i { position: absolute; top: 4rpx; left: 4rpx; width: 28rpx; height: 28rpx; border-radius: 50%; background: #fff; transition: transform .18s ease; }
.settings-mini-toggle.is-on { background: #347cf8; }
.settings-mini-toggle.is-on i { transform: translateX(26rpx); }
.settings-privacy { display: grid; gap: 7rpx; margin: 20rpx 4rpx 15rpx; color: #77838f; font-size: 20rpx; line-height: 1.55; }
.settings-privacy strong { color: #526170; font-size: 21rpx; }
.settings-privacy text { font-size: 20rpx; }
.profile-logout-button { width: 100%; min-height: 84rpx; margin: 0; border: 1rpx solid #d7dfe8; border-radius: 23rpx; background: #ffffff; color: #536170; font-size: 23rpx; font-weight: 760; line-height: 84rpx; }
