.profile-page { overflow-x: hidden; background: #fff; padding-left: 36rpx; padding-right: 36rpx; }

.profile-header { width: max-content; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-start; gap: 18rpx; padding: 0 0 20rpx; }
.settings-trigger { box-sizing: border-box; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 1rpx solid #d8dfe7; border-radius: 50%; background: #fff; color: #1f2c39; box-shadow: 0 10rpx 24rpx rgba(31,48,70,.09); }
.settings-glyph { font-family: Arial, sans-serif; font-size: 46rpx; font-weight: 600; line-height: 1; }
.profile-page-title { color: #17212d; font-size: 43rpx; font-weight: 820; line-height: 1; }

.event-trigger { position: relative; box-sizing: border-box; width: 88rpx; height: 88rpx; flex: 0 0 88rpx; display: flex; align-items: center; justify-content: center; margin: 0; padding: 0; border: 1rpx solid #d7dde5; border-radius: 27rpx; background: #fff; color: #4d5967; }

.profile-intro { display: flex; align-items: center; gap: 32rpx; padding: 18rpx 0 0; }
.profile-avatar { width: 160rpx; height: 160rpx; box-shadow: none; flex: 0 0 160rpx; }
.profile-intro-copy { min-width: 0; }
.profile-name { overflow: hidden; color: #17212d; font-size: 56rpx; font-weight: 820; line-height: 1.3; text-overflow: ellipsis; white-space: normal; overflow-wrap: anywhere; }
.profile-role { overflow: hidden; margin-top: 6rpx; color: #6f7b88; font-size: 28rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.passport-id { margin-top: 18rpx; color: #788595; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 700; letter-spacing: 3rpx; }

.visibility-panel { box-sizing: border-box; display: grid; grid-template-columns: minmax(0, 1fr) 104rpx; align-items: center; gap: 28rpx; margin: 40rpx 0 24rpx; padding: 30rpx; border: 1rpx solid #d8dee5; border-radius: 40rpx; background: #fff; }
.micro-label { color: #758395; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 760; letter-spacing: 3rpx; }
.visibility-title { margin-top: 8rpx; color: #17212d; font-size: 36rpx; font-weight: 800; line-height: 1.3; }
.visibility-detail { margin-top: 8rpx; color: #73808d; font-size: 26rpx; line-height: 1.55; }
.profile-switch-wrap { box-sizing: border-box; min-width: 104rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-end; justify-self: end; margin: 0; padding: 0; border: 0; background: transparent; line-height: 1; width: 104rpx; max-width: 104rpx; }
.profile-switch-wrap.is-disabled { opacity: .48; }
.profile-switch { position: relative; box-sizing: border-box; width: 92rpx; height: 56rpx; border: 1rpx solid #cfd6de; border-radius: 99rpx; background: #d8dde3; transition: background .18s ease; }
.profile-switch-knob { position: absolute; top: 6rpx; left: 6rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff; box-shadow: 0 3rpx 8rpx rgba(31,48,70,.18); transition: transform .18s ease; }
.profile-switch.is-on { border-color: #347cf8; background: #347cf8; }
.profile-switch.is-on .profile-switch-knob { transform: translateX(36rpx); }

.outward-card { overflow: hidden; margin-bottom: 28rpx; border: 1rpx solid #d8dee5; border-radius: 52rpx; background: #fff; box-shadow: 0 36rpx 88rpx rgba(31,48,70,.09); margin: 32rpx 0 40rpx; }
.outward-card-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 24rpx; padding: 34rpx 34rpx 24rpx; }
.outward-title { margin-top: 10rpx; color: #17212d; font-size: 36rpx; font-weight: 820; letter-spacing: -1rpx; }
.block-count { flex: 0 0 auto; margin-top: 4rpx; padding: 10rpx 15rpx; border-radius: 99rpx; background: #edf3fd; color: #2869cf; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 800; letter-spacing: 2rpx; }
.outward-identity { display: grid; grid-template-columns: 86rpx minmax(0, 1fr) auto; align-items: center; gap: 20rpx; margin: 0 34rpx 26rpx; padding: 24rpx 0; border-top: 1rpx solid #e3e8ed; border-bottom: 1rpx solid #e3e8ed; }
.outward-avatar { width: 84rpx; height: 84rpx; }
.outward-person { min-width: 0; display: grid; gap: 6rpx; }
.outward-name { overflow: hidden; color: #17212d; font-size: 28rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.outward-role { overflow: hidden; color: #707c88; font-size: 24rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.public-state { padding: 9rpx 13rpx; border-radius: 99rpx; background: #e8f5ee; color: #2d7253; font-size: 24rpx; font-weight: 760; white-space: normal; max-width: 144rpx; line-height: 1.4; }

.public-blocks { display: grid; gap: 16rpx; padding: 0 24rpx 24rpx; }
.public-block { min-width: 0; display: grid; grid-template-columns: 96rpx minmax(0, 1fr); align-items: center; gap: 22rpx; padding: 24rpx; border: 1rpx solid #dce3ea; border-radius: 36rpx; background: #f7f9fb; }
.public-block-mark { width: 96rpx; height: 96rpx; display: flex; align-items: center; justify-content: center; border-radius: 22rpx; background: #eaf2ff; color: #2869cf; font-family: "SFMono-Regular", Menlo, monospace; font-size: 28rpx; font-weight: 850; }
.public-block-body { min-width: 0; display: grid; gap: 5rpx; }
.public-block-kicker { color: #778493; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; font-weight: 750; letter-spacing: 2rpx; }
.public-block-title { overflow: hidden; color: #263341; font-size: 28rpx; line-height: 1.4; text-overflow: ellipsis; white-space: normal; overflow-wrap: anywhere; }
.public-block-detail { overflow: hidden; color: #75818e; font-size: 24rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; overflow-wrap: anywhere; }
.public-block-authorization { width: fit-content; margin-top: 5rpx; padding: 0; border-radius: 0; background: transparent; color: #6d7782; font-size: 24rpx; font-weight: 700; letter-spacing: 0; }
.public-block-authorization.is-authorized { background: #e8f5ee; color: #2d7253; }
.public-empty { min-height: 268rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; margin: 0 24rpx 24rpx; padding: 40rpx; border: 2rpx dashed #ccd8e5; border-radius: 36rpx; background: #f8fafc; text-align: center; }
.empty-add { width: 78rpx; height: 78rpx; display: flex; align-items: center; justify-content: center; margin-bottom: 18rpx; border-radius: 24rpx; background: #edf3fd; color: #347cf8; font-size: 47rpx; font-weight: 300; line-height: 1; }
.public-empty-title { color: #17212d; font-size: 28rpx; }
.public-empty-copy { max-width: 520rpx; margin-top: 12rpx; color: #75818e; font-size: 24rpx; line-height: 1.55; }
.outward-actions { display: flex; grid-template-columns: 1.2fr 1fr; gap: 16rpx; padding: 24rpx 24rpx 0; border-top: 1rpx solid #e3e8ed; }
.profile-add-content, .profile-edit-foundation { min-height: 88rpx; margin: 0; border-radius: 23rpx; font-size: 22rpx; font-weight: 780; line-height: 88rpx; }
.profile-add-content { background: #347cf8; color: #fff; }
.add-content-icon { margin-right: 4rpx; font-size: 34rpx; vertical-align: -2rpx; }
.profile-edit-foundation { border: 1rpx solid #d6dee7; background: #fff; color: #536170; }
button.profile-add-content, button.profile-edit-foundation { box-sizing: border-box; width: 0; min-width: 0; max-width: 100%; flex: 1 1 0%; padding: 22rpx 10rpx; min-height: 92rpx; font-size: 26rpx; line-height: 1.5; border-radius: 28rpx; }
button.profile-add-content { flex: 1.25 1 0%; }
.public-boundary { padding: 19rpx 31rpx 28rpx; color: #798692; font-size: 24rpx; line-height: 1.5; text-align: center; }

.profile-loading-state, .profile-error-state { min-height: 600rpx; display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 48rpx 24rpx; text-align: center; }
.state-title { margin-top: 24rpx; color: #17212d; font-size: 30rpx; }
.state-copy { max-width: 520rpx; margin-top: 12rpx; color: #74808c; font-size: 22rpx; line-height: 1.55; }
.loading-orbit { width: 66rpx; height: 66rpx; border: 5rpx solid #dce7f8; border-top-color: #347cf8; border-radius: 50%; animation: profile-loading 1s linear infinite; }
.error-mark { width: 74rpx; height: 74rpx; display: flex; align-items: center; justify-content: center; border-radius: 24rpx; background: #eef1f4; color: #65717e; font-size: 40rpx; font-weight: 800; }
.retry-load-button { min-width: 220rpx; min-height: 88rpx; margin: 30rpx 0 0; border: 1rpx solid #d1dae4; border-radius: 23rpx; background: #fff; color: #344252; font-size: 24rpx; font-weight: 760; line-height: 88rpx; }
@keyframes profile-loading { to { transform: rotate(360deg); } }

.device-preview { box-sizing: border-box; margin-bottom: 28rpx; padding: 32rpx; border: 1rpx solid #d8dee5; border-radius: 44rpx; background: #fff; }
.device-preview-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; margin-bottom: 22rpx; }
.device-preview-title { margin-top: 10rpx; color: #17212d; font-size: 36rpx; font-weight: 800; }
.sync-chip { display: grid; gap: 3rpx; padding: 10rpx 13rpx; border-radius: 18rpx; background: #eef6f1; color: #547062; text-align: right; }
.sync-state { color: #2d7253; font-size: 20rpx; }
.sync-detail { font-size: 20rpx; }
.demo-badge { overflow: hidden; border: 10rpx solid #17212d; border-radius: 30rpx; background: #fff; box-shadow: inset 0 0 0 1rpx #cbd6e4, 0 20rpx 48rpx rgba(24,43,68,.14); box-sizing: border-box; position: relative; width: 100%; max-width: 600rpx; min-height: 960rpx; margin: 0 auto; display: flex; flex-direction: column; }
.demo-badge.is-paused { filter: grayscale(.65); opacity: .72; }
.demo-badge-top { display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 6rpx 20rpx; padding: 16rpx 28rpx; border-bottom: 1rpx solid #d9e2eb; min-height: 104rpx; background: #17212d; color: #fff; }
.demo-badge-brand { color: #fff; font-size: 24rpx; font-weight: 900; letter-spacing: 1rpx; }
.demo-badge-brand-cn { margin-left: 5rpx; color: #347cf8; font-size: 20rpx; }
.demo-badge-event { overflow: hidden; color: #b9c5d3; font-size: 20rpx; font-weight: 700; text-align: left; text-overflow: ellipsis; white-space: nowrap; grid-column: 1 / -1; grid-row: 2; }
.demo-badge-state { grid-column: 2; color: #d8e7ff; font-size: 20rpx; font-weight: 760; grid-row: 1; }
.demo-badge-main { display: grid; gap: 24rpx; padding: 28rpx 32rpx 20rpx; flex: 1; }
.badge-identity { display: grid; grid-template-columns: 128rpx minmax(0, 1fr); align-items: center; gap: 26rpx; min-height: 196rpx; border-bottom: 1rpx solid #d7e0eb; }
.badge-avatar { width: 128rpx; height: 128rpx; }
.badge-identity-copy { min-width: 0; display: grid; gap: 4rpx; }
.badge-kicker { color: #7a8794; font-family: "SFMono-Regular", Menlo, monospace; font-size: 20rpx; letter-spacing: 1rpx; }
.badge-name { overflow: hidden; color: #17212d; font-size: 44rpx; text-overflow: ellipsis; white-space: nowrap; line-height: 1.3; }
.badge-role { overflow: hidden; color: #64717e; font-size: 24rpx; text-overflow: ellipsis; white-space: nowrap; }
.badge-intent { display: grid; gap: 14rpx; padding: 26rpx 28rpx; border-radius: 26rpx; background: #eaf2ff; min-height: 164rpx; }
.badge-intent-title { color: #17212d; font-size: 36rpx; line-height: 1.4; }
.badge-intent-detail { color: #5f7290; font-size: 20rpx; }
.badge-connect { display: flex; grid-template-columns: 76rpx minmax(0, 1fr); align-items: center; gap: 12rpx; flex-direction: column; padding: 16rpx 0; justify-content: center; text-align: center; }
.badge-connect-title { align-self: center; color: #17212d; font-size: 26rpx; }
.badge-connect-detail { align-self: center; color: #74808c; font-size: 24rpx; }
.badge-qr { grid-row: 1 / 3; width: 180rpx; height: 180rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 4rpx; padding: 5rpx; border: 1rpx solid #cbd5df; background: #fff; }
.badge-qr-cell { background: #1f2b38; }
.badge-qr-cut { background: #fff; box-shadow: inset 0 0 0 4rpx #1f2b38; }
.demo-badge-foot { display: flex; align-items: center; justify-content: space-between; gap: 10rpx; padding: 0 26rpx; color: #657382; font-size: 20rpx; min-height: 72rpx; border-top: 1rpx solid #d5e0ee; background: #eef4ff; }
.badge-code { font-family: "SFMono-Regular", Menlo, monospace; font-weight: 800; }
.edit-badge-button { width: 100%; min-height: 88rpx; margin: 20rpx 0 0; border: 1rpx solid #d2dbe4; border-radius: 22rpx; background: #f7f9fb; color: #485767; font-size: 28rpx; font-weight: 760; line-height: 88rpx; box-sizing: border-box; min-width: 100%; max-width: 100%; }

.platform-panel { box-sizing: border-box; margin-bottom: 24rpx; padding: 29rpx 26rpx 24rpx; border: 1rpx solid #d8dee5; border-radius: 34rpx; background: #fff; }
.platform-panel-head { display: flex; align-items: flex-start; justify-content: space-between; gap: 18rpx; }
.platform-count { flex: 0 0 auto; padding: 8rpx 12rpx; border-radius: 99rpx; background: #f1f3f6; color: #707c89; font-size: 24rpx; }
.platform-title { margin-top: 10rpx; color: #17212d; font-size: 36rpx; font-weight: 800; }
.platform-note { margin: 16rpx 0 20rpx; color: #75818e; font-size: 24rpx; line-height: 1.55; }
.platform-list { overflow: hidden; border: 1rpx solid #dce3eb; border-radius: 25rpx; background: #fff; }
.platform-row { display: grid; grid-template-columns: 66rpx minmax(0, 1fr) 104rpx; align-items: center; gap: 15rpx; padding: 19rpx; border-bottom: 1rpx solid #e6ebf0; }
.platform-row:last-child { border-bottom: 0; }
.platform-mark { width: 64rpx; height: 64rpx; display: flex; align-items: center; justify-content: center; border-radius: 19rpx; background: #eaf2ff; color: #347cf8; font-size: 21rpx; font-weight: 800; }
.github-mark { background: #17212d; color: #fff; font-size: 20rpx; }
.xhs-mark { background: #f1f3f6; color: #596675; font-size: 20rpx; }
.platform-main { min-width: 0; }
.platform-main .card-title { font-size: 28rpx; }
.platform-input { height: 88rpx; margin-top: 3rpx; color: #536170; font-size: 26rpx; line-height: 88rpx; }
.platform-save-button { min-width: 104rpx; min-height: 88rpx; margin: 0; padding: 0 15rpx; border: 1rpx solid #d3dbe4; border-radius: 18rpx; background: #f7f9fb; color: #536170; font-size: 24rpx; line-height: 88rpx; width: 104rpx; max-width: 104rpx; }
.account-note { margin: 0 0 20rpx; padding: 21rpx 23rpx; border-radius: 23rpx; background: #f0f2f5; color: #6f7b87; font-size: 24rpx; line-height: 1.55; }

.profile-fields { overflow: hidden; margin-bottom: 24rpx; border: 1rpx solid #dce2e9; border-radius: 28rpx; background: #fff; }
.profile-field-row { box-sizing: border-box; width: 100%; min-height: 112rpx; display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 16rpx; margin: 0; padding: 20rpx 23rpx; border: 0; border-bottom: 1rpx solid #e7ebf0; border-radius: 0; background: #fff; color: #17212d; line-height: 1.2; text-align: left; min-width: 100%; max-width: 100%; }
.profile-field-row.is-last { border-bottom: 0; }
.profile-field-copy { min-width: 0; display: grid; gap: 8rpx; }
.profile-field-title { font-size: 28rpx; }
.profile-field-detail { overflow: hidden; color: #778390; font-size: 24rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.profile-field-value { color: #6c7885; font-size: 24rpx; }

.settings-overlay { position: fixed; z-index: 1000; inset: 0; display: flex; align-items: flex-end; }
.settings-backdrop { position: absolute; inset: 0; background: rgba(20,28,38,.28); }
.settings-sheet { position: relative; z-index: 2; box-sizing: border-box; width: 100%; height: 88vh; overflow-y: auto; border-radius: 40rpx 40rpx 0 0; background: #f5f7fa; box-shadow: 0 -20rpx 52rpx rgba(31,48,70,.14); }
.settings-sheet-content { box-sizing: border-box; min-height: 100%; padding: 24rpx 36rpx calc(36rpx + env(safe-area-inset-bottom)); }
.settings-handle { width: 78rpx; height: 8rpx; margin: 0 auto 22rpx; border-radius: 99rpx; background: #cdd4dc; }
.settings-head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 20rpx; }
.settings-title { display: block; margin-top: 6rpx; color: #17212d; font-size: 36rpx; }
.settings-close { width: 88rpx; height: 88rpx; margin: 0; padding: 0; border: 1rpx solid #d9e0e7; border-radius: 50%; background: #fff; color: #546271; font-size: 34rpx; line-height: 88rpx; min-width: 88rpx; max-width: 88rpx; flex: 0 0 88rpx; }
.settings-list { overflow: hidden; border: 1rpx solid #dce2e9; border-radius: 28rpx; background: #fff; }
.settings-row { box-sizing: border-box; width: 100%; min-height: 116rpx; display: grid; grid-template-columns: 68rpx minmax(0, 1fr) 92rpx; align-items: center; gap: 17rpx; margin: 0; padding: 20rpx 22rpx; border: 0; border-bottom: 1rpx solid #e7ebf0; border-radius: 0; background: #fff; color: #17212d; line-height: 1.2; text-align: left; min-width: 100%; max-width: 100%; }
.settings-row.is-last { border-bottom: 0; }
.settings-mark { width: 66rpx; height: 66rpx; display: flex; align-items: center; justify-content: center; border-radius: 20rpx; background: #eef3f8; color: #526170; font-size: 22rpx; font-weight: 800; }
.settings-row-copy { min-width: 0; display: grid; gap: 7rpx; }
.settings-row-title { font-size: 28rpx; }
.settings-row-detail { overflow: hidden; color: #778390; font-size: 24rpx; text-overflow: ellipsis; white-space: normal; line-height: 1.5; }
.settings-arrow { color: #9aa4ae; font-size: 34rpx; font-weight: 400; justify-self: end; }
.settings-sfx { font-size: 20rpx; }
.settings-mini-toggle { position: relative; width: 92rpx; height: 56rpx; border-radius: 99rpx; background: #d6dce2; }
.settings-toggle-knob { position: absolute; top: 6rpx; left: 6rpx; width: 44rpx; height: 44rpx; border-radius: 50%; background: #fff; transition: transform .18s ease; }
.settings-mini-toggle.is-on { background: #347cf8; }
.settings-mini-toggle.is-on .settings-toggle-knob { transform: translateX(36rpx); }
.settings-privacy { display: grid; gap: 7rpx; margin: 20rpx 4rpx 15rpx; color: #77838f; font-size: 20rpx; line-height: 1.55; }
.settings-privacy-title { color: #526170; font-size: 26rpx; }
.settings-privacy-copy { font-size: 24rpx; }
.profile-logout-button { width: 100%; min-height: 88rpx; margin: 0; border: 1rpx solid #d7dfe8; border-radius: 23rpx; background: #ffffff; color: #536170; font-size: 28rpx; font-weight: 760; line-height: 88rpx; min-width: 100%; max-width: 100%; }
