<view class="login-page {{isExiting ? 'is-exiting' : ''}}">
  <view
    class="contact-scene"
    style="top: {{contactSceneTop}}px;"
    aria-hidden="true"
  >
    <view class="contact-person contact-person-a"></view>
    <view class="contact-person contact-person-b"></view>
    <view class="contact-pulse"></view>
  </view>

  <view class="room-stage">
    <canvas type="2d" id="splash-frame" class="splash-frame-canvas" aria-hidden="true"></canvas>
    <view wx:if="{{!frameReady}}" class="room-line room-line-left"></view>
    <view wx:if="{{!frameReady}}" class="room-line room-line-right"></view>
    <view class="splash-slogan">
      <view class="splash-slogan-cn">
        <text>人与人先相遇，</text>
        <text>人与 Agent 再共创。</text>
      </view>
      <view class="splash-slogan-en">
        <text>Meet as people.</text>
        <text>Build with agents.</text>
      </view>
    </view>
  </view>

  <view wx:if="{{loginError}}" class="login-retry">
    <button
      class="retry-button"
      hover-class="retry-button-pressed"
      loading="{{loading}}"
      disabled="{{loading}}"
      bindtap="login"
    >
      {{loading ? "正在连接" : "重新连接"}}
    </button>
    <text>{{loginErrorMessage || '连接未完成，请稍后重试。'}}</text>
  </view>

  <view class="brand-footer">
    <image class="brand-logo" src="/assets/cospan-logo.png" mode="aspectFit" />
    <view class="brand-wordmark">
      <text class="brand-name">COSPAN</text>
      <text class="brand-cn">合拍</text>
    </view>
  </view>
</view>
