.room-hero {
  position: relative;
  overflow: hidden;
  margin: 4rpx 0 24rpx;
  padding: 30rpx;
  border: 1rpx solid #d3deeb;
  border-radius: 34rpx;
  background: linear-gradient(145deg, #fbfcff, #f0f5fb);
}

.room-topline { display: flex; align-items: center; justify-content: space-between; gap: 16rpx; }
.live-state { display: flex; align-items: center; gap: 9rpx; padding: 10rpx 14rpx; border-radius: 999rpx; background: #edf7f2; color: #277055; font-size: 20rpx; font-weight: 750; }
.live-state .state-dot { width: 9rpx; height: 9rpx; border-radius: 50%; background: #2f9870; box-shadow: 0 0 0 7rpx rgba(47,152,112,.1); }
.room-title { margin-top: 28rpx; font-size: 45rpx; font-weight: 760; line-height: 1.18; }
.room-summary { margin-top: 13rpx; color: #627184; font-size: 24rpx; line-height: 1.55; }
.room-members { display: flex; align-items: center; gap: 14rpx; margin-top: 25rpx; color: #536170; font-size: 21rpx; }
.member-stack { display: flex; padding-left: 12rpx; }
.member-stack > view { width: 30rpx; height: 30rpx; margin-left: -12rpx; border: 3rpx solid #f5f8fc; border-radius: 50%; background: #d9e7ff; }
.member-stack > view:nth-child(2) { background: #dcefe8; }
.member-stack > view:nth-child(3) { background: #efe5ff; }

.plan-card { padding: 30rpx; }
.plan-title { margin-top: 8rpx; }
.plan-state,
.task-mode,
.task-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #eef1f5;
  color: #626e7b;
  font-size: 21rpx;
}

.confirmation-progress { margin-top: 27rpx; padding: 21rpx 22rpx; border: 1rpx solid #e0e6ed; border-radius: 21rpx; background: #f8fafc; }
.confirmation-progress > view:first-child { display: flex; align-items: center; justify-content: space-between; color: #657383; font-size: 21rpx; }
.confirmation-progress .progress-count { color: #263442; font-family: "SFMono-Regular", Menlo, monospace; font-weight: 700; }
.progress-track { height: 8rpx; margin-top: 16rpx; overflow: hidden; border-radius: 999rpx; background: #dfe5ec; }
.progress-value { height: 100%; border-radius: inherit; background: #347cf8; }

.agency-boundary { display: grid; grid-template-columns: 48rpx minmax(0,1fr); align-items: center; gap: 14rpx; margin-top: 20rpx; padding: 18rpx 20rpx; border-left: 5rpx solid #347cf8; border-radius: 5rpx 18rpx 18rpx 5rpx; background: #eaf2ff; color: #5d6e81; font-size: 22rpx; line-height: 1.5; }
.boundary-mark { width: 48rpx; height: 48rpx; display: flex; align-items: center; justify-content: center; border-radius: 15rpx; background: #347cf8; color: #fff; font-weight: 800; }

.task-section-head { display: flex; align-items: flex-end; justify-content: space-between; gap: 18rpx; margin: 26rpx 4rpx 18rpx; }
.task-section-head .section-title { margin: 0; }
.task-count { min-width: 44rpx; height: 44rpx; display: flex; align-items: center; justify-content: center; border-radius: 14rpx; background: #eaf2ff; color: #347cf8; font-size: 21rpx; font-weight: 800; }
.task-card { border-radius: 28rpx; }

.task-number {
  color: #347cf8;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.task-title {
  margin-top: 20rpx;
}

.task-copy {
  margin-top: 14rpx;
  color: #4f555f;
  line-height: 1.6;
}

.acceptance {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f1f4f8;
  color: #526274;
  font-size: 24rpx;
  line-height: 1.55;
}

.acceptance text { display: block; margin-bottom: 7rpx; color: #7a8794; font-size: 19rpx; font-weight: 700; }

.owner-line {
  margin-top: 18rpx;
}

.room-feedback { margin-bottom: 24rpx; line-height: 1.6; }
.action-feedback { padding: 24rpx; border: 1rpx solid #dfe3e8; border-radius: 20rpx; background: #f5f6f8; color: #343c46; font-size: 25rpx; }
.plan-source { margin-top: 16rpx; }
.agent-section { margin-top: 28rpx; padding-top: 26rpx; border-top: 1rpx solid #e4e7eb; }
.agent-heading { color: #343c46; font-size: 26rpx; font-weight: 650; }
.agent-section .meta { margin-top: 12rpx; line-height: 1.6; }
.agent-brief { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #e4e7eb; border-radius: 20rpx; background: #f8f9fa; overflow-wrap: anywhere; word-break: break-word; }
.brief-body { display: block; margin-top: 20rpx; white-space: pre-wrap; color: #343c46; font-size: 25rpx; line-height: 1.75; }
.brief-part { margin-top: 22rpx; }
.agent-caption { margin-bottom: 10rpx; color: #68717c; font-size: 22rpx; font-weight: 600; }
.brief-tag { display: inline-block; padding: 6rpx 12rpx; margin: 0 10rpx 10rpx 0; border-radius: 10rpx; background: #eef0f3; color: #505964; font-size: 22rpx; }
.brief-line { color: #505964; font-size: 24rpx; line-height: 1.7; }
.agent-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.page .agent-button { width: auto; min-height: 76rpx; height: auto; margin: 20rpx 0 0; padding: 16rpx 22rpx; border: 1rpx solid #dce1e6; border-radius: 16rpx; background: #f1f3f5; color: #343c46; font-size: 25rpx; line-height: 1.6; }
.agent-actions .agent-button { flex: 1; min-width: 170rpx; margin-top: 0; }
.page .agent-button[disabled] { color: #8a929c; background: #f5f6f8; }
.room-footer { margin: 28rpx 4rpx 10rpx; line-height: 1.6; }

/* Task summaries stay readable; long context is disclosed on demand. */
.page { padding-left: 36rpx; padding-right: 36rpx; background: #fff; }
.room-hero { padding: 8rpx 0 28rpx; border: 0; border-bottom: 1rpx solid #e0e5eb; border-radius: 0; background: transparent; }
.room-title { margin-top: 20rpx; font-size: 44rpx; line-height: 1.3; }
.room-topline .live-state { padding: 6rpx 12rpx; background: #f1f4f7; color: #596778; font-size: 24rpx; }
.page .room-summary-toggle, .page .task-disclosure { box-sizing: border-box; width: auto; min-width: 120rpx; max-width: 240rpx; min-height: 88rpx; display: flex; align-items: center; justify-content: flex-start; margin: 0; padding: 16rpx 0; border: 0; background: transparent; color: #286edb; font-size: 26rpx; line-height: 1.4; }
.page .room-summary-toggle::after, .page .task-disclosure::after { border: 0; }
.page .plan-card { padding: 28rpx; border: 1rpx solid #e0e5eb; border-radius: 28rpx; background: #f7f8fa; box-shadow: none; }
.confirmation-progress { margin-top: 18rpx; padding: 0; border: 0; background: transparent; }
.confirmation-progress > view:first-child { font-size: 24rpx; }
.plan-state, .task-status { flex: 0 0 auto; font-size: 24rpx; }
.plan-consent-note { margin-top: 20rpx; color: #687687; font-size: 24rpx; line-height: 1.5; }
.page .task-card { padding: 24rpx 0; margin: 0; border: 0; border-bottom: 1rpx solid #e0e5eb; border-radius: 0; box-shadow: none; background: transparent; }
.task-card > .status-line { gap: 20rpx; align-items: flex-start; }
.task-card .task-title { flex: 1; min-width: 0; margin: 0; font-size: 32rpx; line-height: 1.4; }
.task-card .owner-line { align-items: center; margin-top: 4rpx; }
.task-card .owner-line .meta { font-size: 26rpx; }
.task-copy { font-size: 28rpx; }
.task-card > button { box-sizing: border-box; width: 100%; min-width: 100%; max-width: 100%; min-height: 88rpx; margin-top: 12rpx; font-size: 28rpx; }
