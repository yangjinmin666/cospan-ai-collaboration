.plan-state,
.task-mode,
.task-status {
  padding: 7rpx 14rpx;
  border-radius: 999rpx;
  background: #e9ebee;
  color: #626873;
  font-size: 21rpx;
}

.task-number {
  color: #a0a4ac;
  font-size: 22rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.task-title {
  margin-top: 20rpx;
}

.task-copy {
  margin-top: 14rpx;
  color: #4f555f;
  line-height: 1.6;
}

.acceptance {
  margin-top: 18rpx;
  padding: 18rpx 20rpx;
  border-radius: 18rpx;
  background: #f0f1f3;
  color: #656b75;
  font-size: 24rpx;
  line-height: 1.55;
}

.owner-line {
  margin-top: 18rpx;
}

.room-feedback { margin-bottom: 24rpx; line-height: 1.6; }
.action-feedback { padding: 24rpx; border: 1rpx solid #dfe3e8; border-radius: 20rpx; background: #f5f6f8; color: #343c46; font-size: 25rpx; }
.plan-source { margin-top: 16rpx; }
.agent-section { margin-top: 28rpx; padding-top: 26rpx; border-top: 1rpx solid #e4e7eb; }
.agent-heading { color: #343c46; font-size: 26rpx; font-weight: 650; }
.agent-section .meta { margin-top: 12rpx; line-height: 1.6; }
.agent-brief { margin-top: 22rpx; padding: 22rpx; border: 1rpx solid #e4e7eb; border-radius: 20rpx; background: #f8f9fa; overflow-wrap: anywhere; word-break: break-word; }
.brief-body { display: block; margin-top: 20rpx; white-space: pre-wrap; color: #343c46; font-size: 25rpx; line-height: 1.75; }
.brief-part { margin-top: 22rpx; }
.agent-caption { margin-bottom: 10rpx; color: #68717c; font-size: 22rpx; font-weight: 600; }
.brief-tag { display: inline-block; padding: 6rpx 12rpx; margin: 0 10rpx 10rpx 0; border-radius: 10rpx; background: #eef0f3; color: #505964; font-size: 22rpx; }
.brief-line { color: #505964; font-size: 24rpx; line-height: 1.7; }
.agent-actions { display: flex; flex-wrap: wrap; gap: 16rpx; margin-top: 22rpx; }
.page .agent-button { width: auto; min-height: 76rpx; height: auto; margin: 20rpx 0 0; padding: 16rpx 22rpx; border: 1rpx solid #dce1e6; border-radius: 16rpx; background: #f1f3f5; color: #343c46; font-size: 25rpx; line-height: 1.6; }
.agent-actions .agent-button { flex: 1; min-width: 170rpx; margin-top: 0; }
.page .agent-button[disabled] { color: #8a929c; background: #f5f6f8; }
.room-footer { margin: 28rpx 4rpx 10rpx; line-height: 1.6; }
