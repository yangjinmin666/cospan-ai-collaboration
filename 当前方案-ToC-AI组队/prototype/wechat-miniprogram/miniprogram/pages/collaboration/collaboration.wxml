<view class="page collaboration-page" style="padding-top: {{navigationTop}}px;">
  <view class="collaboration-head">
    <button class="event-trigger icon-button" bindtap="openEventSelector" aria-label="选择当前范围，当前为 {{scopeLabel}}">
      <image class="ui-icon" src="/assets/ui-event.svg" mode="aspectFit" />
    </button>
    <view><view class="title">协作</view></view>
  </view>

  <view class="collaboration-feedback" wx:if="{{loading || loadError}}"><text>{{loadError || '正在更新…'}}</text><button wx:if="{{loadError}}" bindtap="load">重试</button></view>

  <block wx:if="{{invitations.length}}">
    <view class="section-title">待你确认 · {{invitations.length}}</view>
    <view class="card invitation-card" wx:for="{{invitations}}" wx:key="id">
      <view class="card-title">{{item.project.title}}</view>
      <view class="meta">{{item.counterpart.display_name}} 邀请你负责「{{item.role_need.title}}」</view>
      <button class="primary-button" data-invitation-id="{{item.id}}" bindtap="acceptInvitation">确认加入</button>
    </view>
  </block>

  <view class="status-line section-heading">
    <view class="section-title">我的项目</view>
    <button class="mini-action" bindtap="toggleCreate">{{showCreate ? '收起' : '+ 新建'}}</button>
  </view>

  <view class="card" wx:if="{{showCreate}}">
    <view class="card-title create-title">新建项目</view>
    <label class="field-label">项目名</label>
    <input class="input" placeholder="例如：现场 AI 工牌" data-field="title" bindinput="updateProjectField" />
    <label class="field-label">一句话目标</label>
    <textarea class="textarea" placeholder="这个项目要解决什么" data-field="summary" bindinput="updateProjectField" />
    <label class="field-label">当前最缺的角色</label>
    <input class="input" placeholder="例如：交互设计" data-field="roleTitle" bindinput="updateProjectField" />
    <label class="field-label">该角色需要的技能</label>
    <input class="input" placeholder="交互，视觉，用户测试" data-field="roleSkills" bindinput="updateProjectField" />
    <button class="primary-button" loading="{{creating}}" bindtap="createProject">创建项目</button>
  </view>

  <view class="card project-card" wx:for="{{projects}}" wx:key="id">
    <view class="project-topline">
      <view class="project-state">{{item.statusLabel}}</view>
      <view class="project-member-count">{{item.members.length}} 人 · {{item.membershipLabel}}</view>
    </view>
    <view class="project-title">{{item.title}}</view>
    <view class="project-summary">{{item.summary}}</view>
    <button class="secondary-button enter-space" data-project-id="{{item.id}}" bindtap="openRoom">查看进展 <image class="ui-icon" src="/assets/ui-forward.svg" mode="aspectFit" /></button>
    <button wx:if="{{item.inviteOptions.length}}" class="invite-toggle" data-project-id="{{item.id}}" bindtap="toggleInviteOptions">{{expandedInvites[item.id] ? '收起邀请' : '邀请搭档'}}</button>
    <block wx:if="{{expandedInvites[item.id]}}">
    <button
      wx:for="{{item.inviteOptions}}"
      wx:key="key"
      wx:for-item="option"
      class="quiet-button invite-action"
      data-project-id="{{item.id}}"
      data-option-key="{{option.key}}"
      bindtap="inviteCandidate"
    >
      邀请 {{option.displayName}} 负责「{{option.roleTitle}}」
    </button>
    </block>
  </view>
  <block wx:if="{{!projects.length}}">
    <view class="empty" wx:if="{{!showCreate}}">还没有项目，可以先认识一位搭档，再一起创建</view>
  </block>
  <view class="collaboration-footnote">手机接收进展与确认，电脑展开专业工作。</view>
</view>
<scope-selector visible="{{scopeOpen}}" scope="{{discoveryScope}}" event-id="{{scopeEventId}}" events="{{eventChoices}}" bind:close="closeScopeSelector" bind:selectscope="selectDiscoveryScope" bind:managevisibility="manageScopeVisibility" />
