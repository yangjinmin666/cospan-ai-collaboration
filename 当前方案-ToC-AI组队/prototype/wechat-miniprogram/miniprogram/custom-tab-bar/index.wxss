.tab-safe {
  position: fixed;
  z-index: 99;
  right: 0;
  bottom: 0;
  left: 0;
  padding: 0 32rpx calc(32rpx + env(safe-area-inset-bottom));
  pointer-events: none;
}

.tab-shell {
  box-sizing: border-box;
  min-height: 144rpx;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  align-items: center;
  padding: 16rpx;
  border: 1rpx solid rgba(23, 33, 45, 0.1);
  border-radius: 48rpx;
  background: rgba(248, 249, 251, 0.96);
  box-shadow: 0 32rpx 56rpx rgba(31, 48, 70, 0.16), 0 12rpx 24rpx rgba(31, 48, 70, 0.08);
  pointer-events: auto;
}

.tab-item {
  min-height: 112rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8rpx;
  border-radius: 32rpx;
  color: #89928d;
  font-size: 22rpx;
  font-weight: 650;
}

.tab-item.is-active {
  color: #347cf8;
}

.tab-icon {
  width: 48rpx;
  height: 48rpx;
}
