<view class="tab-safe" wx:if="{{!overlayOpen}}">
  <view class="tab-shell">
    <view
      class="tab-item {{selected === index ? 'is-active' : ''}}"
      wx:for="{{list}}"
      wx:key="pagePath"
      data-path="{{item.pagePath}}"
      data-index="{{index}}"
      bindtap="switchTab"
    >
      <image wx:if="{{selected === index}}" class="tab-icon" src="/assets/nav-{{item.icon}}-active.svg" mode="aspectFit" />
      <image wx:else class="tab-icon" src="/assets/nav-{{item.icon}}.svg" mode="aspectFit" />
      <text>{{item.text}}</text>
    </view>
  </view>
</view>
