@import "./styles/ui-icons.wxss";

page {
  min-height: 100%;
  background: #f7f8fa;
  color: #17212d;
  font-family: -apple-system, BlinkMacSystemFont, "PingFang SC", sans-serif;
  font-size: 28rpx;
}

.page {
  box-sizing: border-box;
  min-height: 100vh;
  padding: 24rpx 32rpx calc(176rpx + env(safe-area-inset-bottom));
}

.hero {
  padding: 20rpx 4rpx 28rpx;
}

.eyebrow {
  color: #6f7b89;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 19rpx;
  font-weight: 700;
  letter-spacing: 3rpx;
}

.title {
  margin-top: 14rpx;
  font-size: 46rpx;
  font-weight: 700;
  line-height: 1.18;
}

.subtitle {
  margin-top: 12rpx;
  color: #6f7b89;
  font-size: 25rpx;
  line-height: 1.55;
}

.card {
  box-sizing: border-box;
  margin-bottom: 22rpx;
  padding: 28rpx;
  border: 1rpx solid #dbe2ea;
  border-radius: 30rpx;
  background: #ffffff;
  box-shadow: 0 16rpx 38rpx rgba(31, 48, 70, 0.055);
}

.card-title {
  font-size: 30rpx;
  font-weight: 700;
  line-height: 1.3;
}

.muted {
  color: #7b8794;
}

.meta {
  margin-top: 8rpx;
  color: #6f7b89;
  font-size: 23rpx;
  line-height: 1.5;
}

.section-title {
  margin: 34rpx 4rpx 18rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.tag-row {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 18rpx;
}

.tag {
  padding: 9rpx 17rpx;
  border: 1rpx solid #dce3ea;
  border-radius: 999rpx;
  background: #f7f9fb;
  color: #465565;
  font-size: 22rpx;
}

.field-label {
  display: block;
  margin: 24rpx 2rpx 10rpx;
  color: #344252;
  font-size: 24rpx;
  font-weight: 700;
}

.input,
.textarea,
.picker {
  box-sizing: border-box;
  width: 100%;
  padding: 22rpx 24rpx;
  border: 1rpx solid #d7dfe8;
  border-radius: 18rpx;
  background: #fff;
  color: #263442;
  font-size: 27rpx;
}

.input {
  height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.picker {
  min-height: 88rpx;
  padding: 0 24rpx;
  line-height: 88rpx;
}

.textarea {
  min-height: 160rpx;
  padding: 20rpx 24rpx;
  line-height: 1.55;
}

.primary-button,
.secondary-button,
.quiet-button {
  margin-top: 22rpx;
  min-height: 88rpx;
  border-radius: 22rpx;
  font-size: 27rpx;
  font-weight: 700;
  line-height: 88rpx;
}

.primary-button {
  background: #347cf8;
  color: #fff;
  box-shadow: 0 12rpx 28rpx rgba(52, 124, 248, 0.2);
}

.secondary-button {
  border: 1rpx solid #ccd7e4;
  background: #fff;
  color: #263442;
}

.quiet-button {
  border: 1rpx solid #dce3ea;
  background: #f4f6f8;
  color: #536170;
}

.primary-button[disabled],
.secondary-button[disabled],
.quiet-button[disabled] {
  border-color: #e0e5eb;
  background: #edf0f3;
  color: #9aa4ae;
  box-shadow: none;
}

button::after {
  border: 0;
}

.empty {
  padding: 48rpx 24rpx;
  color: #8b9099;
  text-align: center;
}

.status-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 18rpx;
}

.switch-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.notice {
  margin-bottom: 20rpx;
  padding: 22rpx 24rpx;
  border-left: 5rpx solid #347cf8;
  border-radius: 6rpx 22rpx 22rpx 6rpx;
  background: #eaf2ff;
  color: #58697b;
  font-size: 24rpx;
  line-height: 1.55;
}

.surface-label {
  color: #347cf8;
  font-family: "SFMono-Regular", Menlo, monospace;
  font-size: 18rpx;
  font-weight: 800;
  letter-spacing: 2rpx;
}

.avatar {
  display: flex;
  flex: 0 0 auto;
  align-items: center;
  justify-content: center;
  border: 1rpx solid #d6e0eb;
  background: #eef4ff;
  color: #245fc8;
  font-weight: 800;
}

.memoji-avatar {
  position: relative;
  flex: 0 0 auto;
  display: block;
  overflow: hidden;
  border: 1rpx solid #d9dee5;
  border-radius: 50%;
  background-color: #fff;
  box-shadow: inset 0 0 0 4rpx rgba(255, 255, 255, 0.72);
}

.memoji-sheet {
  position: absolute;
  z-index: 0;
  width: 450%;
  height: 600%;
  max-width: none;
}

.memoji-1 .memoji-sheet { left: -28.49%; top: -25.58%; }
.memoji-2 .memoji-sheet { left: -175%; top: -26.17%; }
.memoji-3 .memoji-sheet { left: -319.77%; top: -27.91%; }
.memoji-4 .memoji-sheet { left: -19.19%; top: -169.19%; }
.memoji-5 .memoji-sheet { left: -171.51%; top: -169.77%; }
.memoji-6 .memoji-sheet { left: -323.26%; top: -168.61%; }
.memoji-7 .memoji-sheet { left: -18.02%; top: -321.51%; }
.memoji-8 .memoji-sheet { left: -175.58%; top: -322.68%; }
.memoji-9 .memoji-sheet { left: -323.26%; top: -318.61%; }
.memoji-10 .memoji-sheet { left: -22.09%; top: -466.28%; }
.memoji-11 .memoji-sheet { left: -173.84%; top: -465.7%; }
.memoji-12 .memoji-sheet { left: -318.61%; top: -466.28%; }

.hairline {
  height: 1rpx;
  background: #e2e7ed;
}
