{
  "name": "cospan-cross-platform-spike",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:assets": "node scripts/assets.mjs",
    "dev:h5": "npm run prepare:assets && uni --host 127.0.0.1 --port 4180",
    "build:h5": "npm run prepare:assets && uni build -p h5",
    "build:mp-weixin": "npm run prepare:assets && uni build -p mp-weixin",
    "typecheck": "npm run prepare:assets && vue-tsc --noEmit",
    "test": "node --test test/*.test.ts"
  },
  "dependencies": {
    "@dcloudio/uni-app": "3.0.0-5020420260813003",
    "@dcloudio/uni-components": "3.0.0-5020420260813003",
    "@dcloudio/uni-h5": "3.0.0-5020420260813003",
    "@dcloudio/uni-mp-weixin": "3.0.0-5020420260813003",
    "vue": "3.4.21",
    "vue-i18n": "9.14.5"
  },
  "devDependencies": {
    "@dcloudio/types": "3.4.31",
    "@dcloudio/uni-cli-shared": "3.0.0-5020420260813003",
    "@dcloudio/vite-plugin-uni": "3.0.0-5020420260813003",
    "miniprogram-automator": "0.12.1",
    "typescript": "5.6.3",
    "vite": "5.2.8",
    "vue-tsc": "2.1.10"
  }
}
